# Copy this file to .env. Never commit the filled-in file.
STEVESBOT_ROOT=.
STEVESBOT_ROLE=all
STEVESBOT_DRY_RUN=true
STEVESBOT_WEB_HOST=127.0.0.1
STEVESBOT_WEB_PORT=8787

# Discord
DISCORD_BOT_TOKEN=
REVIEW_CHANNEL_ID=
REVIEW_ALERT_MENTION=
STEVESBOT_MAINTAINER_USER_IDS=
STEVESBOT_MAINTAINER_USERNAMES=
STEVESBOT_BOT_USER_ID=

# Shared model timeout
STEVESBOT_MODEL_TIMEOUT_MS=180000

# Local OpenAI-compatible endpoints. These are optional fallbacks.
LOCAL_QWEN_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_QWEN_MODEL=local-primary
LOCAL_QWEN_API_KEY=
LOCAL_QWEN_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_QWEN_FALLBACK_MODEL=local-fallback
LOCAL_QWEN_TIMEOUT_MS=180000
STEVESBOT_ENABLE_LOCAL_QWEN_FALLBACK=true

# High-reasoning primary drafter. Verify current endpoint/model names with your provider.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.2
OPENCODE_TIMEOUT_MS=180000

# Lower-cost/free OpenCode-compatible fallbacks, tried in order.
OPENCODE_FALLBACK_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_FALLBACK_API_KEY=
OPENCODE_FALLBACK_MODEL_1=deepseek-v4-flash-free
OPENCODE_FALLBACK_MODEL_2=big-pickle
OPENCODE_FALLBACK_MODEL_3=
OPENCODE_FALLBACK_MODEL_4=
OPENCODE_FALLBACK_TIMEOUT_MS=180000

# Optional last-resort coding-plan endpoint.
ZAI_CODING_BASE_URL=
ZAI_CODING_API_KEY=
ZAI_CODING_MODEL=
ZAI_CODING_TIMEOUT_MS=180000
STEVESBOT_ENABLE_ZAI_FALLBACK=true

# Queue and feature controls
STEVESBOT_WORKER_CONCURRENCY=1
STEVESBOT_QUEUE_POLL_MS=1000
STEVESBOT_QUEUE_LEASE_MS=60000
STEVESBOT_QUEUE_MAX_ATTEMPTS=3
STEVESBOT_QUEUE_RETRY_MS=15000
STEVESBOT_ENABLE_CLARIFY=true
STEVESBOT_ENABLE_NO_ANSWER=true
